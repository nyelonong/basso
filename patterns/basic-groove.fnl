   {:step 4 :sample "cl_hihat.wav"}
   {:step 5 :sample "cl_hihat.wav"}
   {:step 6 :sample "cl_hihat.wav"}
   {:step 7 :sample "cl_hihat.wav"}
   {:step 8 :sample "kick2.wav"}
   {:step 8 :sample "cl_hihat.wav"}
   {:step 9 :sample "cl_hihat.wav"}
   {:step 10 :sample "cl_hihat.wav"}
   {:step 11 :sample "cl_hihat.wav"}
   {:step 12 :sample "snare.wav"}
   {:step 12 :sample "cl_hihat.wav"}
   {:step 13 :sample "cl_hihat.wav"}
   {:step 14 :sample "cl_hihat.wav"}
   {:step 15 :sample "cl_hihat.wav"}])

